<Project Sdk="Microsoft.NET.Sdk">
  <!-- Beamcam.exe: the window. Thin on purpose: sessions live in Beamcam.Core, video in Beamcam.Platform. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Beamcam</AssemblyName>
    <RootNamespace>Beamcam.App</RootNamespace>
    <ApplicationIcon>Assets/beamcam.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- ThemeMode (the Windows 11 look) is marked experimental in WPF. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/beamcam-256.png" />
    <Resource Include="Assets/beamcam.ico" />
    <ProjectReference Include="../Beamcam.Platform/Beamcam.Platform.csproj" />
  </ItemGroup>
</Project>
