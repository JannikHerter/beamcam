<Window x:Class="Beamcam.App.AddressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Beamcam.App"
        Title="{app:Tr ConnectByAddress}" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="24">
    <TextBlock Text="{app:Tr ConnectByAddress}" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Text="{app:Tr TypeAddress}" TextWrapping="Wrap" Margin="0,8,0,0"
               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    <Grid Margin="0,16,0,0">
      <TextBox x:Name="Input" AutomationProperties.Name="{app:Tr Address}" Padding="6,5" />
      <TextBlock x:Name="Placeholder" Text="192.168.1.23" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center"
                 Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
    </Grid>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button Content="{app:Tr Cancel}" IsCancel="True" Padding="20,6" />
      <Button Content="{app:Tr Connect}" IsDefault="True" Padding="20,6" Margin="8,0,0,0" Style="{DynamicResource AccentButtonStyle}" Click="OnConnect" />
    </StackPanel>
  </StackPanel>
</Window>
