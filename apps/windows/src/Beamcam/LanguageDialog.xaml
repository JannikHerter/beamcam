<Window x:Class="Beamcam.App.LanguageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Beamcam.App"
        Title="{app:Tr Language}" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="24">
    <TextBlock Text="{app:Tr Language}" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Text="{app:Tr LanguageRestart}" TextWrapping="Wrap" Margin="0,8,0,0"
               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    <StackPanel x:Name="Choices" Margin="0,16,0,0" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button Content="{app:Tr Cancel}" IsCancel="True" Padding="20,6" />
      <Button Content="{app:Tr RestartBeamcam}" IsDefault="True" Padding="20,6" Margin="8,0,0,0" Style="{DynamicResource AccentButtonStyle}" Click="OnRestart" />
    </StackPanel>
  </StackPanel>
</Window>
