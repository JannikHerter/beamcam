<Window x:Class="Beamcam.App.PairedPhonesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paired Phones" Width="460" Height="440" MinWidth="340" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock x:Name="Intro" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
               Text="These phones let this computer in without asking. If you forget one, click Connect and tap Allow on the phone to use it again." />
    <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
      <ItemsControl x:Name="List" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource Icons}" Text="&#xE8EA;" FontSize="20" VerticalAlignment="Center" Margin="0,0,14,0" />
                <Button DockPanel.Dock="Right" Content="Forget" Padding="14,5" VerticalAlignment="Center" Click="OnForget" Tag="{Binding}"
                        AutomationProperties.Name="{Binding ForgetLabel}" />
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <StackPanel x:Name="Empty" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Center" Visibility="Collapsed">
      <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8EA;" FontSize="40" HorizontalAlignment="Center" />
      <TextBlock Text="No Paired Phones" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
      <TextBlock Text="Phones you connect to show up here." HorizontalAlignment="Center" Margin="0,6,0,0"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </StackPanel>
    <Button x:Name="ForgetAll" Grid.Row="2" Content="Forget All" HorizontalAlignment="Center" Padding="20,6" Margin="0,12,0,0" Click="OnForgetAll" />
  </Grid>
</Window>
