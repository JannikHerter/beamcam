<Window x:Class="Beamcam.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Beamcam.App"
        Title="Beamcam" Width="760" Height="580" MinWidth="360" MinHeight="420"
        Icon="Assets/beamcam.ico" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Button x:Name="MenuButton" Grid.Row="0" HorizontalAlignment="Right" Margin="0,8,12,0" Padding="10,6"
            Click="OnMenu" ToolTip="{app:Tr MainMenu}" AutomationProperties.Name="{app:Tr MainMenu}">
      <app:Glyph FontFamily="{StaticResource Icons}" Text="&#xE700;" FontSize="16" />
      <Button.ContextMenu>
        <ContextMenu>
          <MenuItem Header="{app:Tr ConnectByAddressMenu}" Click="OnConnectByAddress" />
          <MenuItem Header="{app:Tr PairedPhones}" Click="OnPairedPhones" />
          <MenuItem Header="{app:Tr LanguageMenu}" Click="OnLanguage" />
          <Separator />
          <MenuItem Header="{app:Tr AboutBeamcam}" Click="OnAbout" />
        </ContextMenu>
      </Button.ContextMenu>
    </Button>

    <Border x:Name="Banner" Grid.Row="1" Visibility="Collapsed" Margin="16,8,16,0" Padding="14,10" CornerRadius="6"
            BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
      <DockPanel>
        <app:Glyph DockPanel.Dock="Left" FontFamily="{StaticResource Icons}" Text="&#xE7BA;" FontSize="16" Margin="0,1,10,0" />
        <TextBlock x:Name="BannerText" TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <Grid Grid.Row="2">
      <!-- Looking for phones / choose a phone -->
      <ScrollViewer x:Name="PhonesPage" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" MaxWidth="460">
          <app:Glyph FontFamily="{StaticResource Icons}" Text="&#xE714;" FontSize="48" HorizontalAlignment="Center"
                     Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
          <TextBlock x:Name="PhonesTitle" Style="{StaticResource Heading}" Margin="0,16,0,0" />
          <TextBlock x:Name="PhonesDescription" Style="{StaticResource Secondary}" TextAlignment="Center" Margin="0,8,0,0" />
          <ProgressBar x:Name="Searching" IsIndeterminate="True" Width="200" Margin="0,24,0,0" AutomationProperties.Name="{app:Tr LookingForPhones}" />
          <ItemsControl x:Name="PhoneList" Margin="0,24,0,0" Width="380" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                  <DockPanel>
                    <app:Glyph DockPanel.Dock="Left" FontFamily="{StaticResource Icons}" Text="&#xE8EA;" FontSize="22"
                               VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button DockPanel.Dock="Right" Content="{app:Tr Connect}" Style="{DynamicResource AccentButtonStyle}" Padding="16,6"
                            VerticalAlignment="Center" Click="OnConnectPhone" Tag="{Binding}"
                            AutomationProperties.Name="{Binding ConnectLabel}" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Secondary}" FontSize="12" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="{app:Tr ConnectByAddressMenu}" HorizontalAlignment="Center" Margin="0,16,0,0" Padding="16,6" Click="OnConnectByAddress" />
        </StackPanel>
      </ScrollViewer>

      <!-- Connecting / tap Allow / reconnecting -->
      <StackPanel x:Name="ConnectingPage" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" MaxWidth="480">
        <app:Glyph FontFamily="{StaticResource Icons}" Text="&#xE8EA;" FontSize="48" HorizontalAlignment="Center"
                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        <TextBlock x:Name="ConnectingTitle" Style="{StaticResource Heading}" Margin="0,16,0,0" />
        <TextBlock x:Name="ConnectingDescription" Style="{StaticResource Secondary}" TextAlignment="Center" Margin="0,8,0,0" />
        <TextBlock x:Name="ConnectingCode" Visibility="Collapsed" FontSize="40" FontWeight="SemiBold" HorizontalAlignment="Center"
                   Margin="0,16,0,0" />
        <ProgressBar IsIndeterminate="True" Width="200" Margin="0,24,0,0" AutomationProperties.Name="{app:Tr Connecting}" />
        <Button Content="{app:Tr Cancel}" HorizontalAlignment="Center" Margin="0,24,0,0" Padding="20,6" Click="OnCancel" />
      </StackPanel>

      <!-- Streaming -->
      <Grid x:Name="StreamingPage" Visibility="Collapsed" Margin="0,8,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="Black">
          <Image x:Name="Preview" Stretch="Uniform" AutomationProperties.Name="{app:Tr PictureFromPhone}" />
        </Border>
        <DockPanel Grid.Row="1" Margin="18,12">
          <Button DockPanel.Dock="Right" Content="{app:Tr Disconnect}" Padding="16,6" Margin="12,0,0,0" VerticalAlignment="Center" Click="OnCancel" />
          <Button DockPanel.Dock="Right" Content="{app:Tr SwitchCamera}" Padding="16,6" VerticalAlignment="Center" Click="OnSwitchCamera" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="StreamingTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="StreamingHint" Style="{StaticResource Secondary}" />
          </StackPanel>
        </DockPanel>
      </Grid>

      <Border x:Name="Toast" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24,0,24,24"
              Padding="16,10" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}">
        <TextBlock x:Name="ToastText" TextWrapping="Wrap" MaxWidth="520" AutomationProperties.LiveSetting="Polite" />
      </Border>
    </Grid>
  </Grid>
</Window>
