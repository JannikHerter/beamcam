# The AUR package "beamcam". It downloads the release; packaging/build-arch.sh builds this
# checkout with it instead, and arch/update-aur.sh fills in the checksum for the AUR.
pkgname=beamcam
pkgver=0.2.0
pkgrel=1
pkgdesc='Use your Android phone as a wireless webcam'
arch=('any')
url='https://github.com/JannikHerter/beamcam'
license=('GPL-3.0-or-later')
depends=(
  'python' 'python-gobject' 'python-cryptography' 'gtk4' 'libadwaita' 'polkit'
  'gstreamer' 'gst-plugins-base' 'gst-plugins-good' 'gst-plugins-bad' 'gst-libav' 'gst-plugin-gtk4'
)
optdepends=('v4l2loopback-dkms: the virtual camera other apps see (on Manjaro: linuxXY-v4l2loopback)')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver/apps/linux"
  python -m build --wheel --no-isolation
}

package() {
  cd "$pkgname-$pkgver/apps/linux"
  python -m installer --destdir="$pkgdir" dist/*.whl
  sh packaging/install-data.sh "$pkgdir"
}
