<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Beamcam</vendor>
  <icon_name>org.beamcam.Beamcam</icon_name>
  <action id="org.beamcam.Beamcam.setup-virtual-camera">
    <description>Set up the Beamcam virtual camera</description>
    <message>Enter your password to set up or remove the camera that other apps see.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/beamcam/setup-virtual-camera</annotate>
  </action>
</policyconfig>
